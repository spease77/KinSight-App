# Copy to .env.local and fill in from Supabase Dashboard → Settings → API

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here

# Optional but recommended for server-side saves (Dashboard → Settings → API Keys → Secret key)
SUPABASE_SECRET_KEY=your-secret-key-here

# OpenAI — Whisper transcription + GPT-4.1-mini parsing
OPENAI_API_KEY=your-openai-api-key-here

# ElevenLabs — natural voice (used when ELEVENLABS_API_KEY is set)
# Get key: https://elevenlabs.io/app/settings/api-keys
# Browse voices: https://elevenlabs.io/voice-library — copy the Voice ID
ELEVENLABS_API_KEY=your-elevenlabs-api-key-here
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
# Optional tuning (0–1)
ELEVENLABS_STABILITY=0.45
ELEVENLABS_SIMILARITY=0.8

# OpenAI TTS (used when ELEVENLABS_API_KEY is not set)
# Female voices: shimmer (warm), sage (calm), nova (upbeat), coral
OPENAI_TTS_VOICE=nova
OPENAI_TTS_MODEL=tts-1-hd
OPENAI_TTS_SPEED=0.96

# Faster transcription (or whisper-1 for classic Whisper)
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe

# Faster agent (or claude-sonnet-4-6 for max intelligence)
ANTHROPIC_AGENT_MODEL=claude-haiku-4-5-20251001
KINSIGHT_SPEED_MODE=true
AGENT_MAX_OUTPUT_TOKENS=350

# Anthropic — Claude 3.5 Sonnet pre-flight summaries
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Feedback emails (Resend — https://resend.com)
RESEND_API_KEY=re_your-resend-api-key
FEEDBACK_TO_EMAIL=scottpease77@gmail.com
# Until you verify a domain, use onboarding@resend.dev (sends only to your Resend account email)
FEEDBACK_FROM_EMAIL=KinSight <onboarding@resend.dev>

# Maintenance reminder cron — daily scan at /api/cron/maintenance-reminders
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CRON_SECRET=your-cron-secret-here

# Optional — POST reminder JSON to Pushover, n8n, Zapier, etc.
# MAINTENANCE_PUSH_WEBHOOK_URL=https://your-service.com/webhook

# Optional — reminder email recipient (defaults to FEEDBACK_TO_EMAIL)
# MAINTENANCE_NOTIFICATION_TO_EMAIL=you@example.com
# MAINTENANCE_NOTIFICATION_FROM_EMAIL=KinSight <onboarding@resend.dev>
